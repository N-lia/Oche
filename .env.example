# Copy to .env and fill in. Never commit the real .env.

# Nebius Token Factory (telegram bot, webapp agent, and phone vision loop).
NEBIUS_API_KEY=

# Shared secret used by the Android app's outbound WebSocket.
# Generate with: openssl rand -hex 32
OYI_DEVICE_TOKEN=

# Secret used by the Telegram bot / agent tool to call the webapp device API.
# In a single-user setup this may be the same value as OYI_DEVICE_TOKEN.
OYI_DEVICE_API_TOKEN=

# Vision planner. The phone sends a screenshot + accessibility tree, and this
# model chooses one action per step.
OYI_DEVICE_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# OYI_DEVICE_VISION_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Public base URL of the webapp that exposes /ws/device and /api/device/*.
# Used by the Telegram bot and the agent's control_phone tool.
OYI_DEVICE_GATEWAY_URL=https://your-oyi-host.example

# Telegram (existing configuration; shown here for convenience).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
